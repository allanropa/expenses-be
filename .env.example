# Backend - desarrollo local (sin Docker)
# Copiar a .env y ajustar.

# Required when using Docker Compose.
# POSTGRES_PASSWORD=replace-with-a-long-random-password

# SQLite sin configuración adicional.
DATABASE_URL=sqlite:///./expenses.db

# Alternativa: PostgreSQL local.
# DATABASE_URL=postgresql+psycopg://expenses:change-me@localhost:5432/expenses

SESSION_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGIN=http://localhost:5173

# MCP: token fijo y correo del usuario cuyos datos se exponen.
# MCP_API_TOKEN=replace-with-a-long-random-secret
# MCP_USER_EMAIL=user@example.com
